{
  "name": "corpus-kb-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Corpus-KB lifecycle SPA (built into src/corpus_kb/ui_dist, served at /app)",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=12.0.0 <13.0.0"
  },
  "scripts": {
    "dev": "vite",
    "sync-manifest": "node scripts/copy-manifest.mjs",
    "record-fixtures": "node scripts/record-fixtures.ts",
    "prelint": "pnpm run sync-manifest",
    "pretest": "pnpm run sync-manifest",
    "prebuild": "pnpm run sync-manifest",
    "lint": "tsc --noEmit && eslint src",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle.mjs",
    "check-bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "antd": "^6.6.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
