{
  "name": "corpus-kb-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Corpus-KB lifecycle SPA (built into src/corpus_kb/ui_dist, served at /app)",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=12.0.0 <13.0.0"
  },
  "scripts": {
    "dev": "vite",
    "record-fixtures": "node scripts/record-fixtures.ts",
    "lint": "tsc --noEmit && eslint src",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle.mjs",
    "check-bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@ant-design/x": "2.10.0",
    "@dagrejs/dagre": "3.1.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@tanstack/react-query": "^5.104.5",
    "@xyflow/react": "12.12.1",
    "antd": "^6.6.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jscpd": "5.4.2",
    "jsdom": "^30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
