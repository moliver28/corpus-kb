{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "pin",
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "commitMessagePrefix": "chore",
  "commitMessageTopic": "deps",
  "prCreation": "immediate",
  "platformAutomerge": true,
  "ignorePaths": [
    "licenses.lock.json",
    "docs/**",
    ".venv-licenses/**",
    "node_modules/**"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Group all GitHub Actions updates into one weekly PR",
      "groupName": "github-actions",
      "matchManagers": ["github-actions"],
      "schedule": ["before 6am on monday"],
      "reviewers": ["@moliver28"],
      "labels": ["dependencies", "github-actions"]
    },
    {
      "description": "Group Python dev/test dependencies (pytest, syrupy, etc.)",
      "groupName": "python-dev-deps",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["optional-dependencies"],
      "matchCategories": ["dev"],
      "schedule": ["before 6am on monday"],
      "reviewers": ["@moliver28"],
      "labels": ["dependencies", "python-dev"]
    },
    {
      "description": "Group pre-commit hook updates",
      "groupName": "pre-commit-hooks",
      "matchManagers": ["pre-commit"],
      "schedule": ["before 6am on monday"],
      "reviewers": ["@moliver28"],
      "labels": ["dependencies", "pre-commit"]
    },
    {
      "description": "Automerge patch updates for production deps after CI passes",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["patch", "pin"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "labels": ["dependencies", "automerge"]
    },
    {
      "description": "Require reviewer for major/minor production updates",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["major", "minor"],
      "reviewers": ["@moliver28"],
      "assignees": ["@moliver28"],
      "labels": ["dependencies", "needs-review"]
    },
    {
      "description": "Do not bump packages past 0.x without manual review",
      "matchDepTypes": ["dependencies", "optional-dependencies"],
      "matchCurrentVersion": "!/^0\\./",
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "Never touch the license baseline file",
      "paths": ["licenses.lock.json"],
      "enabled": false
    }
  ]
}