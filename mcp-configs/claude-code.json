{
  "mcpServers": {
    "corpus-kb": {
      "name": "Corpus-KB",
      "description": "Local RAG system — search, ingest, knowledge graph, SQL queries over your code and documents",
      "command": "corpus-kb",
      "args": [
        "--transport",
        "stdio"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "search",
        "search_context",
        "search_similar",
        "retrieve_context",
        "list_documents",
        "get_stats",
        "list_versions",
        "list_branches",
        "get_entity_relations",
        "search_graph",
        "graph_neighbors",
        "graph_traverse",
        "sql_query",
        "sql_tables",
        "get_document_tags",
        "get_metadata",
        "query_document_stats",
        "sync_database",
        "ingest_status",
        "ingest_reembed",
        "topics_build",
        "topics_list",
        "topics_trends",
        "labeling_build",
        "labeling_list",
        "labeling_lfs",
        "classification_build",
        "classification_list",
        "analysis_backfill_dates",
        "analyze_run",
        "ask"
      ]
    }
  }
}
