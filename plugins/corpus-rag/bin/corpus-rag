#!/usr/bin/env python3
"""Thin ``corpus-rag`` CLI for the corpus-rag plugin (issue #351).

Stdlib only. Every subcommand is one thin surface over the study
registry, the per-study server manager, the op runner, or one engine
CLI command. The parser and the command map live in ``cli_spec.py``;
command bodies live in the ``study_*.py`` modules.

Short map:

``status``   Per-study status; the study's doctor decides the verdict.
``connect``  One MCP entry per study with its env.
``provision``  Create, migrate, and register one study. ``--project-id``
             keeps the 0.7.x raw-table behavior (same as raw-provision).
``raw-provision``  The 0.7.x Track C raw table.
``list`` / ``use`` / ``serve`` / ``stop``  Registry and server lifecycle.
``ingest`` / ``search`` / ``similar`` / ``ask`` / ``sql`` / ``events``
             One op each, through the op runner.
``drain``    Send the study folder's pending queue. Every other command
             auto-drains it first when the folder's ``auto_ingest`` is on
             (except list, provision, migrate, backup, stop).
``doctor`` / ``migrate`` / ``reembed`` / ``backup``  Study maintenance.
``ops`` / ``op``  The live inventory, and any op through the runner.
``engine install``  Clone the engine at the release tag into <state>.
"""

from __future__ import annotations

import sys
from pathlib import Path

PLUGIN_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(PLUGIN_ROOT))

import cli_spec  # noqa: E402
import engine_install  # noqa: E402
import op_client  # noqa: E402
import op_runner  # noqa: E402
import study_queue  # noqa: E402
import study_registry  # noqa: E402
import study_server  # noqa: E402
from study_commands import CommandError  # noqa: E402


def cmd_engine_install(args) -> int:
    """Install the engine from the release tag into the state folder."""
    try:
        print(engine_install.run_install(force=args.force))
        return 0
    except engine_install.EngineInstallError as exc:
        print(f"not ok: {exc}")
        return 1


def main(argv: list[str] | None = None) -> int:
    parser = cli_spec.build_parser()
    args = parser.parse_args(argv)
    if args.command not in study_queue.AUTO_DRAIN_SKIP:
        # Every command but the skip set drains the folder queue first.
        # Silent and fail-open: a drain problem never blocks the command.
        study_queue.auto_drain()
    if args.command == "engine":
        return cmd_engine_install(args)
    try:
        return cli_spec.HANDLERS[args.command](args)
    except CommandError as exc:
        print(exc)
        return 1
    except study_registry.RegistryError as exc:
        print(f"not ok: {exc}")
        return 1
    except study_server.ServerError as exc:
        print(f"not ok: {exc}")
        return 1
    except op_runner.OpError as exc:
        print(f"not ok: {exc}")
        return 2
    except op_client.HttpError as exc:
        print(f"not ok: {exc}")
        return 1
    except KeyboardInterrupt:
        print("Interrupted.")
        return 130


if __name__ == "__main__":
    sys.exit(main())
